// Static site: `next build` exports to ./out (output: "export"), served as Workers static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brandheist",
  "compatibility_date": "2026-10-01",
  // Runs before every `wrangler deploy`, so a push to the repo builds the site on Cloudflare.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
