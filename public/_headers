# Browser caching (Cloudflare Workers static assets reads this file from the build output).
# HTML is left at the default (always revalidated) so new deploys show up immediately.

# Next.js build files have content hashes in their names: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images, video, icon fonts: not hashed, so cache for a week and refresh quietly in the background.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
